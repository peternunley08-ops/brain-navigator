# Copy to .env and fill in. Never commit .env.
# These are build-time values the app reads (EXPO_PUBLIC_ means they ship
# inside the app, so only public identifiers go here, never secret keys).
# Secret keys (Anthropic, Notion) live only as Supabase function secrets.

# Supabase project (Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in for Calendar (Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Notion databases the app syncs to (the ID in each database's URL)
EXPO_PUBLIC_NOTION_CHECKINS_DB_ID=
EXPO_PUBLIC_NOTION_ENTRIES_DB_ID=
EXPO_PUBLIC_NOTION_TASKS_DB_ID=

# Release build for other students: set to 1. Turns off everything wired to
# the developer's own accounts (Notion sync). Leave unset on your own phone.
# See docs/legal/RELEASE-COMPLIANCE.md before releasing.
EXPO_PUBLIC_RELEASE=
