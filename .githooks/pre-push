#!/usr/bin/env bash
# Stop direct pushes to main: every change goes through a pull request.
# GitHub's own branch rule needs a paid plan for a private repo, so this
# guard lives in the repo instead. npm install turns it on (the "prepare"
# script sets core.hooksPath to .githooks).
#
# Emergency only: BN_ALLOW_MAIN=1 git push ...
set -euo pipefail

[[ "${BN_ALLOW_MAIN:-}" == "1" ]] && exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    printf '\n✗ Pushing straight to main is off. Open a pull request instead:\n' >&2
    printf '    git checkout -b yourname/short-topic\n' >&2
    printf '    git push -u origin yourname/short-topic\n' >&2
    printf '    gh pr create --fill\n\n' >&2
    printf '  (Emergency only: BN_ALLOW_MAIN=1 git push ...)\n\n' >&2
    exit 1
  fi
done
exit 0
